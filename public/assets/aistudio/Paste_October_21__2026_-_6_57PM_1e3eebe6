<script>
/* ==================================================================
   1. DỮ LIỆU ÂM
   ================================================================== */

const M = (o,r,h,b) => ({o,r,h,b});
// M(opening, rounding, tongue height, backness): simplified illustration controls,
// not measured articulatory coordinates.
const V = {
 'iː':['sheep','/ʃiːp/', M(.15,0,.95,.15),'Nguyên âm trước, cao; môi thường hơi kéo ngang, lưỡi nâng cao phía trước. Trong nhiều giọng hiện đại, âm có thể kết thúc bằng một chuyển động nhẹ; không chỉ là “i Việt Nam kéo dài”.'],
 'ɪ':['ship','/ʃɪp/', M(.28,0,.78,.22),'Nguyên âm trước gần cao; lưỡi thấp hơn và cơ miệng thư giãn hơn /iː/. Khác nhau cả về chất âm lẫn độ dài, không chỉ là bản ngắn của /iː/.'],
