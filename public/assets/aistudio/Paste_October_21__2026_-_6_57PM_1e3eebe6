    alv:{lo:160,tx:92,ty:134,hx:135,hy:146,c:[92,131],ix:16,iy:5},
    post:{lo:160,tx:105,ty:124,hx:140,hy:140,c:[106,121],ix:11,iy:8},
    rr:{lo:162,tx:110,ty:132,hx:150,hy:134,ix:10,iy:7},
    w:{lo:160,tx:94,ty:168,hx:165,hy:124,ix:7,iy:7},
    pal:{lo:162,tx:94,ty:168,hx:140,hy:118,c:[140,115],ix:17,iy:5},
    vel:{lo:164,tx:94,ty:170,hx:168,hy:121,c:[170,120],ix:17,iy:6},
    glot:{lo:168,tx:94,ty:174,hx:140,hy:172,c:[162,262],ix:16,iy:8}
  };
  let q = T[p.pl];
  if (!q) {
    const lo = 146 + p.o*34, hy = lo+16 - p.h*(lo+16-124);
    q = {lo, tx:94, ty:lo+6, hx:118+p.b*50, hy, ix:20-p.r*12, iy:2+p.o*12+p.r*3};
  }
  window.LQ = q;
  const {lo,tx,ty,hx,hy} = q;
  const air = ['Xát','Tắc–xát','Tắc'].includes(p.air)
    ? `<path class='ar' d='M44 ${lo+12}H16M22 ${lo+6}L16 ${lo+12}L22 ${lo+18}'/>`
    : p.air === 'Mũi'
      ? `<path class='ar' d='M26 102L6 108M6 108L8 99M6 108L15 107'/>`
      : '';
  const vel = n ? 'M175 120Q192 128 192 154' : 'M175 120C190 126 200 134 200 140M186 116L200 140';
  const cord = v
    ? `<path class='vc' d='M152 262h26'/><path class='vc' d='M150 252q4-6 8 0t8 0t8 0t8 0' style='stroke-width:1.5'/>`
    : `<path class='vc' d='M152 254L160 270M178 254L170 270'/>`;
  // ĐÃ BỎ phần <g transform="translate(150 40)"> ... </g> (miệng nhìn từ trước)
  return `<svg class='mouth-svg' viewBox='0 0 210 300' role='img'>
    <path class='tg' d='M${tx} ${ty}C${tx+14} ${ty-4} ${hx-28} ${hy} ${hx} ${hy}C${hx+22} ${hy} 184 ${hy+6} 188 ${hy+30}L188 232C170 224 130 ${ty+22} ${tx} ${ty+12}Q${tx-3} ${ty+6} ${tx} ${ty}Z'/>
    <path class='pl' d='M55 29L22 65Q14 85 25 94L50 96Q56 104 54 112Q44 122 44 134Q46 142 56 141L70 134'/>
    <path class='pl' d='M88 132C108 118 150 110 175 120'/>
    <path class='pl' d='${vel}'/>
    <path class='pl' d='M82 ${lo+2}Q58 ${lo-6} 55 ${lo+6}Q58 ${lo+16} 66 ${lo+26}Q68 210 64 222Q68 236 95 236Q118 232 130 240Q146 262 142 290'/>
    <ellipse class='th' cx='75' cy='132' rx='6' ry='14'/>
    ${lo>=144 ? `<ellipse class='th' cx='86' cy='${lo+9}' rx='5' ry='9'/>` : ''}
    ${q.c ? `<circle class='ct' cx='${q.c[0]}' cy='${q.c[1]}' r='4'/>` : ''}
    ${air}${cord}
    <g font-size='7'>
      <text x='${hx-8}' y='${hy+22}' fill='#fff'>lưỡi</text>
      <text x='108' y='104'>vòm cứng</text>
      <text x='158' y='104'>vòm mềm</text>
      <text x='150' y='288'>dây thanh</text>
    </g>
  </svg>`;
}

// lips: miệng nhìn từ trước – giữ nguyên
function lips() {
  const q = window.LQ || {ix:14, iy:3};
  const cx = 110, cy = 120;
  const mw = 26 + q.ix*2.6, mh = q.iy*2.6;
  const id = 'lp' + (window._li = (window._li || 0) + 1);
  const op = `M${cx-mw} ${cy}C${cx-mw*.6} ${cy-mh*1.3} ${cx+mw*.6} ${cy-mh*1.3} ${cx+mw} ${cy}C${cx+mw*.6} ${cy+mh*1.4} ${cx-mw*.6} ${cy+mh*1.4} ${cx-mw} ${cy}Z`;
  const tw = Math.min(mw*1.7, 120);
  const tt = (y,h) => Array.from({length:6}, (_,i) =>
    `<rect x='${cx-tw/2+i*tw/6+.8}' y='${y}' width='${tw/6-1.6}' height='${h}' rx='5' fill='#fffdf5' stroke='#cfc9b8'/>`
  ).join('');
  const open = mh > 5 && !q.bite;
  return `<svg class='mouth-svg' viewBox='0 0 220 232' role='img'>
    <rect width='220' height='232' rx='20' fill='#f3d9c8'/>
    <path d='M${cx-26} 28Q${cx} 46 ${cx+26} 28' fill='none' stroke='#8a5a50' stroke-width='2'/>
    <ellipse cx='${cx-13}' cy='34' rx='7' ry='4' fill='#6b3b34' opacity='.6'/>
    <ellipse cx='${cx+13}' cy='34' rx='7' ry='4' fill='#6b3b34' opacity='.6'/>
    <path d='M${cx-7} 48Q${cx-9} 62 ${cx-12} ${cy-mh*1.3-24}M${cx+7} 48Q${cx+9} 62 ${cx+12} ${cy-mh*1.3-24}' fill='none' stroke='#8a5a50' stroke-width='1.5' opacity='.5'/>
    <path d='M${cx-mw-8} ${cy}C${cx-mw*.55} ${cy-mh*1.3-36} ${cx+mw*.55} ${cy-mh*1.3-36} ${cx+mw+8} ${cy}C${cx+mw*.55} ${cy+mh*1.4+40} ${cx-mw*.55} ${cy+mh*1.4+40} ${cx-mw-8} ${cy}Z' fill='#c4605e' stroke='#7a2b2b' stroke-width='2'/>
    <path d='M${cx-16} ${cy-mh*1.15-18}Q${cx} ${cy-mh*1.15-10} ${cx+16} ${cy-mh*1.15-18}' fill='none' stroke='#8f3b3b' stroke-width='2'/>
    <ellipse cx='${cx}' cy='${cy+mh*1.4+16}' rx='${mw*.4}' ry='5' fill='#fff' opacity='.28'/>
    <clipPath id='${id}'><path d='${op}'/></clipPath>
    <path d='${op}' fill='#3b0d10'/>
    ${open ? `<g clip-path='url(#${id})'>
      <ellipse cx='${cx}' cy='${cy+mh*.55}' rx='${mw*.75}' ry='${mh*.6}' fill='#d6544a'/>
      ${tt(cy-mh*1.15-2,22)}
      ${tt(cy+mh*1.2-16,20)}
      ${q.tg ? `<ellipse cx='${cx}' cy='${cy}' rx='30' ry='10' fill='#d6544a' stroke='#a33' stroke-width='1.5'/>` : ''}
    </g>` : ''}
    ${q.bite ? tt(cy-6,22) : ''}
    <path d='${op}' fill='none' stroke='#2a0808' stroke-width='2'/>
    <text x='110' y='224' text-anchor='middle' font-size='9' fill='#667'>miệng nhìn từ phía trước</text>
  </svg>`;
}

function pair(p, v, n) {
  return `<div class='ipa-mouth'>${draw0(p, v, n)}${lips()}</div>`;
}

/* ==================================================================
   3. RENDER BẢNG IPA
   ================================================================== */

const vowelRows = [
  {label:'Cao', front:'iː', central:'', back:'uː'},
  {label:'Gần cao', front:'ɪ', central:'', back:'ʊ'},
  {label:'Giữa-cao', front:'e', central:'', back:''},
  {label:'Trung tâm', front:'', central:'ə / ɜː', back:''},
  {label:'Giữa-thấp', front:'', central:'ʌ', back:'ɔː'},
  {label:'Gần thấp', front:'æ', central:'', back:'ɒ'},
  {label:'Thấp', front:'', central:'', back:'ɑː'}
];
const diphthongKeys = ['ɪə','eɪ','ʊə','ɔɪ','əʊ','eə','aɪ','aʊ'];
const consRows = [
  {label:'Tắc', cells:{'Môi–môi':['p','b'],'Lợi':['t','d'],'Ngạc mềm':['k','g']}},
  {label:'Tắc–xát', cells:{'Sau lợi':['tʃ','dʒ']}},
  {label:'Xát', cells:{'Môi–răng':['f','v'],'Răng':['θ','ð'],'Lợi':['s','z'],'Sau lợi':['ʃ','ʒ'],'Thanh hầu':['h']}},
  {label:'Mũi', cells:{'Môi–môi':['m'],'Lợi':['n'],'Ngạc mềm':['ŋ']}},
  {label:'Tiếp cận / bên', cells:{'Lợi':['l'],'Sau lợi':['r'],'Vòm cứng':['j'],'Môi–ngạc mềm':['w']}}
];

function makeSoundButton(k, cls) {
  const data = V[k] || D[k] || C[k];
  const word = data ? data[0] : k;
  const voiced = C[k] ? C[k][4] === 1 : false;
  const klass = cls || (D[k] ? 'diph' : V[k] ? 'vowel' : ('cons ' + (voiced ? 'voiced' : 'unvoiced')));
  return `<button class="ipa-cell ${klass}" data-k="${k}" type="button" aria-label="Âm ${k}"><span class="sym">${k}</span><span class="ex">${word}</span></button>`;
}
function renderVowels() {
  const chart = document.getElementById('vowel-chart');
  let mono = `<div class="chart-section-title">12 nguyên âm đơn</div>
    <p class="chart-help">Sơ đồ gần đúng: từ trên xuống là lưỡi cao đến thấp; từ trái sang phải là trước – trung tâm – sau. Các vị trí minh họa không phải ranh giới tuyệt đối. Bấm vào một ký hiệu IPA để xem hướng dẫn và nghe từ ví dụ có chứa âm đó.</p>
    <div class="vowel-quad"><div class="quad-corner">Độ cao</div><div class="quad-colhead">Trước</div><div class="quad-colhead">Trung tâm</div><div class="quad-colhead">Sau</div>`;
  vowelRows.forEach(row => {
    mono += `<div class="quad-rowlabel">${row.label}</div>`;
    ['front','central','back'].forEach(pos => {
      const val = row[pos];
      if (!val) { mono += '<div class="quad-empty" aria-hidden="true"></div>'; return; }
      if (val.includes(' / ')) {
        mono += `<div class="quad-cell duo-central">${makeSoundButton('ə','vowel')}<div class="quad-separator">và</div>${makeSoundButton('ɜː','vowel')}</div>`;
      } else mono += `<div class="quad-cell">${makeSoundButton(val,'vowel')}</div>`;
    });
  });
  mono += '</div>';
  let diph = `<div class="chart-section-title diph-title">8 nguyên âm đôi (có chuyển động)</div><p class="chart-help">Mỗi âm bắt đầu ở một vị trí rồi trượt về vị trí đích; cách hiện thực có thể thay đổi theo giọng.</p><div class="diph-grid">`;
  diphthongKeys.forEach(k => { diph += makeSoundButton(k,'diph'); });
  diph += '</div>';
  chart.innerHTML = mono + diph;
}
function renderCons() {
  const chart = document.getElementById('cons-chart');
  const places = ['Môi–môi','Môi–răng','Răng','Lợi','Sau lợi','Vòm cứng','Ngạc mềm','Môi–ngạc mềm','Thanh hầu'];
  let html = `<div class="chart-section-title">24 phụ âm tiếng Anh (bảng phân loại theo cách và vị trí cấu âm)</div><p class="chart-help">Các âm được nhóm theo cách tạo âm và vị trí gần đúng. Bấm vào một ký hiệu IPA để xem hướng dẫn và nghe từ ví dụ có chứa âm đó. Một số âm có nhiều biến thể theo giọng; /r/ trong ô này là ký hiệu rộng thường gặp trong từ điển, còn âm tiếp cận điển hình thường được phiên âm hẹp là [ɹ].</p><div class="cons-table"><div class="cons-corner">Cách tạo âm</div>`;
  places.forEach(p => { html += `<div class="cons-place">${p}</div>`; });
  consRows.forEach(row => {
    html += `<div class="cons-manner">${row.label}</div>`;
    places.forEach(place => {
      const sounds = row.cells[place] || [];
      html += `<div class="cons-slot">${sounds.map(k => makeSoundButton(k)).join('')}</div>`;
    });
  });
  html += '</div><div class="chart-legend"><span class="legend-dot voiced-dot"></span> Hữu thanh <span class="legend-dot unvoiced-dot"></span> Vô thanh</div>';
  chart.innerHTML = html;
}
/* ==================================================================
   4. CHI TIẾT ÂM
   ================================================================== */

function showDetail(k) {
  document.querySelectorAll('.ipa-cell.on').forEach(e => e.classList.remove('on'));
  const el = document.querySelector(`.ipa-cell[data-k="${k}"]`);
  if (el) el.classList.add('on');

  let w, wi, vi, tags = '', mouthHtml = '';

  if (V[k]) {
    [w, wi, , vi] = V[k];
    tags = `<span class="ipa-tag hot">Nguyên âm đơn</span><span class="ipa-tag">${k.includes('ː') ? 'Dài' : 'Ngắn / trung tính'}</span>`;
    mouthHtml = pair(V[k][2]);
  } else if (D[k]) {
    const d = D[k];
    [w, wi] = d;
    vi = d[4];
    tags = `<span class="ipa-tag hot">Nguyên âm đôi</span><span class="ipa-tag">/${d[2]}/ → /${d[3]}/</span>`;
    const P = {};
    Object.keys(V).forEach(key => { P[key] = V[key][2]; });
    P.a = M(.82,0,.18,.38); // approximate low starting point used only for /aɪ/ and /aʊ/
    mouthHtml = pair(P[d[2]]) + '<span style="font-size:1.6rem;align-self:center;color:#b31b1b;font-weight:700;">→</span>' + pair(P[d[3]]);
  } else {
    const c = C[k];
    [w, wi] = c;
    vi = c[5];
    const pr = CP[c[2]];
    tags = `<span class="ipa-tag hot">Phụ âm ${c[3].toLowerCase()}</span><span class="ipa-tag">${c[4] ? 'Hữu thanh (rung cổ)' : 'Vô thanh (không rung)'}</span><span class="ipa-tag">${PL[c[2]]}</span>`;
    mouthHtml = pair({ ...pr, pl: c[2], air: c[3] }, c[4], c[3] === 'Mũi');
  }

  const x = X[k];
  const extra = x ? `<div class="ipa-tipbox"><b>Ví dụ:</b> ${x[0]}<br><b>Cách phát âm:</b> ${x[1]}${x[2] ? `<br><b>Lưu ý:</b> ${x[2]}` : ''}</div>` : '';

  document.getElementById('ipa-detail').innerHTML = `
    <div class="ipa-detail-grid">
      <div>
        <div class="ipa-big">/${k}/</div>
        <div class="ipa-word">${w} <span>${wi}</span></div>
        <button class="ipa-btn" onclick="say('${w}',.9)">🔊 Nghe</button>
        <button class="ipa-btn alt" onclick="say('${w}',.45)">🐢 Chậm</button>
        <div class="ipa-tags">${tags}</div>
      </div>
      <div>
        ${mouthHtml}
        <p style="font-size:14px;color:#4a4642;margin:6px 0 0;">
          Hình cắt ngang miệng là minh họa khái quát (môi ở bên trái); hình còn lại mô phỏng miệng nhìn từ phía trước. Màu sắc và vị trí là quy ước minh họa, không phải ảnh giải phẫu hay phép đo chính xác. Bấm vào hình để phóng to.
        </p>
        <div class="ipa-note"><b>So với tiếng Việt:</b> ${vi}</div>
        ${extra}
      </div>
    </div>
  `;

  // Gắn sự kiện phóng to cho SVG vừa render
  document.querySelectorAll('#ipa-detail .mouth-svg').forEach(svg => {
    svg.addEventListener('click', () => openSvgModal(svg));
  });
}

/* ==================================================================
   5. PHÁT ÂM
   ================================================================== */

function say(w, r) {
  if (!('speechSynthesis' in window)) return;
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(w);
  u.lang = 'en-GB';
  u.rate = r || .85;
  speechSynthesis.speak(u);
}

/* ==================================================================
   6. CẶP ÂM DỄ NHẦM
   ================================================================== */

const pairs = [
  ['sheep','ship'], ['leave','live'], ['men','man'], ['cap','cup'],
  ['full','fool'], ['think','sink'], ['then','den'], ['vine','wine'],
  ['cap','cab'], ['back','bag'], ['seat','seed'], ['light','lie'],
  ['miss','mix'], ['sing','sin']
];

function renderPairs() {
  const el = document.getElementById('pair-chips');
  el.innerHTML = pairs.map(p => `<span class="chip" data-p="${p}">${p[0]} – ${p[1]}</span>`).join('');
}

/* ==================================================================
   7. PHÓNG TO SVG (MODAL)
   ================================================================== */

function openSvgModal(svgEl) {
  const modal = document.getElementById('svgModal');
  const body = document.getElementById('svgModalBody');
  body.innerHTML = '';
  const clone = svgEl.cloneNode(true);
  // bỏ class hover/zoom cho bản clone
  clone.style.cursor = 'default';
  body.appendChild(clone);
  modal.classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeSvgModal() {
  document.getElementById('svgModal').classList.remove('open');
  document.getElementById('svgModalBody').innerHTML = '';
  document.body.style.overflow = '';
}

/* ==================================================================
   8. SỰ KIỆN
   ================================================================== */

function bindEvents() {
  document.querySelectorAll('.ipa-chart').forEach(chart => {
    chart.addEventListener('click', e => {
      const b = e.target.closest('.ipa-cell');
      if (b && b.dataset.k) {
        const soundKey = b.dataset.k;
        showDetail(soundKey);
        // Web Speech API không phát âm vị IPA độc lập một cách đáng tin cậy.
        // Vì vậy, tự phát từ ví dụ đại diện cho âm vừa được chọn.
        const soundData = V[soundKey] || D[soundKey] || C[soundKey];
        if (soundData && soundData[0]) say(soundData[0], 0.82);
        if (window.innerWidth < 700) {
          document.getElementById('ipa-detail').scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  });

  document.addEventListener('click', e => {
    const c = e.target.closest('.chip');
    if (!c) return;
    if (c.dataset.w) { say(c.dataset.w, .6); return; }
    if (c.dataset.p) {
      const [a, b] = c.dataset.p.split(',');
      say(a, .8);
      setTimeout(() => say(b, .8), 1100);
    }
  });

  // modal
  document.getElementById('svgModalClose').addEventListener('click', closeSvgModal);
  document.getElementById('svgModal').addEventListener('click', e => {
    if (e.target.id === 'svgModal') closeSvgModal();
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeSvgModal();
  });
}

/* ==================================================================
   9. BACK TO TOP + INIT
   ================================================================== */

function initToTop() {
  const btn = document.getElementById('toTop');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) btn.classList.add('show');
    else btn.classList.remove('show');
  });
}

document.addEventListener('DOMContentLoaded', () => {
  renderVowels();
  renderCons();
  renderPairs();
  bindEvents();
  initToTop();
  showDetail('iː');
});
</script>
